{
  "name": "@openpeepshq/fetch-client",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "sse.js": "^2.5.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "react-native": {
        "types": "./dist/*/index.d.ts",
        "default": "./src/*/index.ts"
      },
      "types": "./dist/*/index.d.ts",
      "node": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "!**/__tests__",
    "!**/*.test.ts"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "lint": "prettier --check . && ESLINT_USE_FLAT_CONFIG=false eslint .",
    "format": "prettier --write .",
    "clean": "rm -rf tsconfig.tsbuildinfo dist",
    "typecheck": "tsc --noEmit",
    "build": "tsc && tsc-alias",
    "build:watch": "tsc && tsc-alias && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "prepublishOnly": "pnpm typecheck && pnpm build && node ../../scripts/check-publish-gate.mjs --package fetch-client"
  }
}
