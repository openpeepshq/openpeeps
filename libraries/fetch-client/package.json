{
  "name": "@openpeepshq/fetch-client",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "sse.js": "^2.5.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "react-native": {
        "types": "./dist/*/index.d.ts",
        "default": "./src/*/index.ts"
      },
      "types": "./dist/*/index.d.ts",
      "node": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "!**/__tests__",
    "!**/*.test.ts"
  ],
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "concurrently": "^9.2.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^6.0.2",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "clean": "rm -rf tsconfig.tsbuildinfo dist",
    "typecheck": "tsc --noEmit",
    "build": "tsc && tsc-alias",
    "build:watch": "tsc && tsc-alias && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm build && node ../../scripts/check-publish-gate.mjs --package fetch-client"
  }
}
