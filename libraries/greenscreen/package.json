{
  "name": "@openpeepshq/greenscreen",
  "version": "0.2.1",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "fast-base64": "^0.1.8"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "!**/__tests__",
    "!**/*.test.ts"
  ],
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.1.0",
    "iso-639-1": "^3.1.3",
    "prettier": "^3.4.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^6.0.2",
    "vite": "^6.0.6",
    "vite-plugin-dts": "^4.4.0",
    "eslint-config-prettier": "^9.1.0",
    "@eslint/js": "^9.17.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist",
    "build:watch": "vite build --watch",
    "prepublishOnly": "pnpm typecheck && pnpm build && node ../../scripts/check-publish-gate.mjs --package greenscreen"
  }
}
