{
  "name": "@openpeepshq/geocoder",
  "version": "0.1.2",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*/index.js"
  },
  "files": [
    "/dist"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^6.0.2",
    "@eslint/js": "^9.17.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "clean": "rm -rf tsconfig.tsbuildinfo dist",
    "build": "tsc && tsc-alias",
    "build:watch": "rm -f tsconfig.tsbuildinfo && tsc && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "olc-plus-codes": "^1.0.1"
  }
}
