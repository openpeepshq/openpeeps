# Example environment for the Traefik deployment stack.
# Copy this file to `.env` and adjust the values for your environment.

# Public domain under which OpenPeeps will be served.
SERVICE_DOMAIN=openpeeps.example.com

# Traefik network name managed by your Traefik container.
TRAEFIK_NETWORK_NAME=traefik-public

# Traefik certificate resolver configured in your Traefik container.
TRAEFIK_CERTRESOLVER=autodns

# Postgres credentials used by the compose-managed postgres service.
POSTGRES_USER=openpeeps
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=openpeeps

# Connection strings used by the OpenPeeps server.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
REDIS_HOST=redis

# JWT secret used to verify access tokens. Must match the value used to
# generate tokens (usually configured on the auth/identity service).
JWT_SECRET=change-me-in-production

# Environment marker. Use `production` for deployed stacks.
ENVIRONMENT=production
