{
  "name": "openpeeps",
  "version": "1.0.0",
  "description": "Monorepo for OpenPeeps",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@gitlab.allpeep-hq.com:allpeep/open-source/ap-at.git"
  },
  "dependencies": {
    "eslint": "^9.17.0",
    "prettier": "^3.4.2"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "@tanstack/react-query": "5.90.16",
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "zod": "4.4.3",
      "@asteasolutions/zod-to-openapi": "8.5.0"
    },
    "onlyBuiltDependencies": [
      "@evilmartians/lefthook",
      "@firebase/util",
      "@sentry/cli",
      "bcrypt",
      "canvas",
      "core-js",
      "core-js-pure",
      "esbuild",
      "hyochan-welcome",
      "msgpackr-extract",
      "protobufjs",
      "sharp",
      "web-audio-api"
    ]
  },
  "scripts": {
    "build-deps": "pnpm -r --filter \"@openpeeps/server...\" --filter \"@openpeeps/web...\" build",
    "check-circular-deps": "ds",
    "check-branch": "node scripts/check-branch.mjs",
    "squash-branch": "scripts/squash-branch.sh"
  },
  "packageManager": "pnpm@11.1.3",
  "devDependencies": {
    "circular-dependency-scanner": "^2.3.0",
    "prettier-plugin-tailwindcss": "^0.6.13"
  }
}
