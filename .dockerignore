.media
**/.media
.home
**/.home
.pnpm-store
.git

node_modules

# Build outputs — the in-container build (pnpm -r build) produces these fresh.
# Excluding them avoids leaking stale local artifacts into the image and keeps
# the build deterministic.
**/dist
**/build
**/*.tsbuildinfo

# Local runtime artifacts
**/.logs
**/coverage
**/test-results
**/playwright-report
**/.loadtest-results
**/.perf-results

# Editor / OS noise
.vscode
.idea
.DS_Store

# Runtime deployment artifacts on prod hosts. Deployed plugin sources are
# volume-mounted at /apat/plugins and must never be baked in: as untracked
# workspace importers (glob `plugins/*/*`) they break --frozen-lockfile
# installs with "dependencies were added".
plugins

# Server-only deploy files
compose*.yml
.env*

# Local scratch / large backups (never needed in images)
stuff
