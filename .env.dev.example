# Copy to .env

JWT_SECRET='xxx'
DATABASE_URL='postgresql://openpeeps:openpeeps@localhost:5432/openpeeps'
# In-app Postgres browser (pgweb sidecar). Omit to disable /_db proxy.
PGWEB_URL='http://127.0.0.1:8081'
# Production: run pgweb with --readonly. Dev docker-compose omits this flag.
# PGWEB_READONLY=true
DB_URL='http://localhost:8529'
DB_NAME='openpeeps'
# Set to false to skip automatic Arango → Postgres migration on startup
# AUTO_MIGRATE_FROM_ARANGO=false