# Copy to `.env` at the repo root (or `platform/server/.env`).
# Values below match local `docker compose` Postgres/Redis defaults.

# --- required for multi-instance / restarts ---
# Cryptographically random fallback is fine for a single local process when
# unset, but production fails fast without this. Generate with:
#   openssl rand -hex 64
# or: ./apc secrets create-jwt-secret (from platform/cli)
JWT_SECRET='xxx'

# --- database ---
DATABASE_URL='postgresql://openpeeps:openpeeps@localhost:5432/openpeeps'
# Legacy Arango (optional; used for one-time migrate if Postgres is empty)
DB_URL='http://localhost:8529'
DB_NAME='openpeeps'
# AUTO_MIGRATE_FROM_ARANGO=false

# --- redis (BullMQ, pub/sub, caches) ---
REDIS_HOST='localhost'
# REDIS_PORT=6379

# --- public host (emails, OIDC redirects, CORS default in production) ---
# SERVER_HOST='localhost:5174'
# SERVER_PROTOCOL='http'
# Comma-separated browser origins for the API. Defaults: production →
# SERVER_HOST origin; local → http://localhost:5174. Use * only for tooling.
# CORS_ORIGINS='http://localhost:5174'

# --- email (SMTP via local Mailpit: UI http://localhost:8025) ---
EMAIL_DEFAULT_FROM='noreply@openpeeps.local'
EMAIL_CONFIG_HOST='localhost'
EMAIL_CONFIG_PORT=1025
EMAIL_CONFIG_SECURE=false
# Mailpit accepts any credentials; leave unset for unauthenticated SMTP.
# EMAIL_CONFIG_AUTH_USER=
# EMAIL_CONFIG_AUTH_PASS=

# --- media storage ---
# MEDIA_STORAGE_PARAMS_HOST=
# MEDIA_STORAGE_PARAMS_PREFIX='/storage'
# MEDIA_STORAGE_PARAMS_PATH='./.media'

# --- jams / LiveKit (leave unset to keep jams disabled) ---
# JAMS_LIVEKIT_URL='https://livekit.example.com'
# JAMS_LIVEKIT_API_KEY=
# JAMS_LIVEKIT_API_SECRET=
# JAMS_LIVEKIT_RECORDING_ENABLED=false

# --- web push (VAPID) ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- payments (Stripe) ---
# PAYMENTS_STRIPE_PUBLISHABLE_KEY=
# PAYMENTS_STRIPE_SECRET_KEY=
# PAYMENTS_STRIPE_WEBHOOK_SECRET=
# PAYMENTS_STRIPE_PRODUCT_ID=
# PAYMENTS_STRIPE_TRIAL_PERIOD_DAYS=0

# --- observability (optional) ---
# Sentry is disabled unless SENTRY_DSN is set to a non-empty value.
# There is no default DSN — self-hosted deploys do not phone home.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional override; otherwise Sentry uses ENVIRONMENT, then defaults to local.
# SENTRY_ENVIRONMENT=
# PERF_SLOW_REQUEST_MS=1000
# PERF_SLOW_QUERY_MS=200
# PERF_SLOW_SPAN_MS=250
# PERF_DB_TIMING=1

# --- misc ---
# Deploy/runtime profile for Sentry + config. Docker CI sets this from the
# git branch: main or prod/* → production, other branches → development.
# Unset locally → local.
# ENVIRONMENT=local
# NETWORK_PORT=5173
# SERVER_MAX_PROFILES=0
# NOMINATIM_API_KEY=
