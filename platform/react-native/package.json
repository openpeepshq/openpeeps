{
  "name": "@openpeeps/react-native",
  "version": "0.2.9",
  "description": "React Native community screens and shared UI (extracted from the Black Ambition app) for the OpenPeeps stack.",
  "source": "./src/index.ts",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/module/index.d.ts",
  "sideEffects": [
    "./src/i18n/index.ts",
    "./src/global.css"
  ],
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./i18n": {
      "react-native": "./src/i18n/index.ts",
      "import": {
        "types": "./lib/typescript/module/i18n/index.d.ts",
        "default": "./lib/module/i18n/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/i18n/index.d.ts",
        "default": "./lib/commonjs/i18n/index.js"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "tailwind.config.js",
    "react-native.config.js",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"src/**/*.{js,ts,tsx}\"",
    "clean": "del-cli lib",
    "build": "bob build",
    "prepublishOnly": "pnpm --filter @openpeeps/react-native... build",
    "release": "release-it"
  },
  "packageManager": "pnpm@11.1.3",
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.allpeep-hq.com/allpeep/open-source/react-native-components.git"
  },
  "author": "OpenPeeps Inc. <dev@allpeep.com> (https://allpeep.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.allpeep-hq.com/allpeep/open-source/react-native-components/issues"
  },
  "homepage": "https://gitlab.allpeep-hq.com/allpeep/open-source/react-native-components#readme",
  "dependencies": {
    "@openpeeps/common": "workspace:^",
    "@openpeeps/react": "workspace:^",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@hookform/resolvers": "^3.10.0",
    "@livekit/react-native": "2.6.0",
    "@livekit/react-native-krisp-noise-filter": "^0.0.3",
    "@livekit/react-native-webrtc": "^137.0.2",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.1.1",
    "@react-native-camera-roll/camera-roll": "^7.10.0",
    "@react-native-clipboard/clipboard": "^1.16.1",
    "@react-native-community/datetimepicker": "^8.3.0",
    "@react-native-community/slider": "^4.5.7",
    "@react-native-documents/picker": "^10.1.3",
    "@react-native-documents/viewer": "^3.0.0",
    "@react-native-firebase/app": "^22.2.1",
    "@react-native-firebase/messaging": "^22.2.1",
    "@react-native/codegen": "0.85.2",
    "@react-native/gradle-plugin": "0.85.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/elements": "^2.2.5",
    "@react-navigation/native": "^7.1.9",
    "@react-navigation/native-stack": "^7.2.0",
    "@rn-primitives/avatar": "~1.1.0",
    "@rn-primitives/checkbox": "^1.1.0",
    "@rn-primitives/label": "^1.1.0",
    "@rn-primitives/portal": "~1.1.0",
    "@rn-primitives/progress": "~1.1.0",
    "@rn-primitives/radio-group": "^1.1.0",
    "@rn-primitives/select": "^1.1.0",
    "@rn-primitives/separator": "^1.1.0",
    "@rn-primitives/slot": "~1.1.0",
    "@rn-primitives/switch": "^1.1.0",
    "@rn-primitives/tabs": "^1.1.0",
    "@rn-primitives/tooltip": "~1.1.0",
    "@rn-primitives/types": "~1.1.0",
    "@sentry/react-native": "^8.7.0",
    "@shopify/flash-list": "^1.7.3",
    "@tanstack/react-query": "^5.90.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^24.2.3",
    "i18next-http-backend": "^3.0.2",
    "js-base64": "^3.7.7",
    "livekit-client": "^2.9.3",
    "lucide-react-native": "^0.474.0",
    "nativewind": "^4.1.23",
    "patch-package": "^8.0.1",
    "react": "19.2.3",
    "react-hook-form": "^7.56.4",
    "react-i18next": "^15.4.1",
    "react-native": "0.85.2",
    "react-native-audio-recorder-player": "^3.6.12",
    "react-native-buffer": "^6.0.3",
    "react-native-calendars": "^1.1308.1",
    "react-native-callkeep": "^4.3.16",
    "react-native-config": "^1.5.5",
    "react-native-convert-ph-asset": "^1.0.3",
    "react-native-css-interop": "^0.1.22",
    "react-native-drawer-layout": "^4.1.1",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.31.0",
    "react-native-image-crop-picker": "^0.51.1",
    "react-native-image-picker": "^8.2.0",
    "react-native-image-viewing": "^0.2.2",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-markdown-display": "^7.0.2",
    "react-native-permissions": "^5.4.0",
    "react-native-reanimated": "~4.3.0",
    "react-native-safe-area-context": "^5.2.0",
    "react-native-screens": "^4.24.0",
    "react-native-sound": "^0.11.2",
    "react-native-svg": "^15.15.4",
    "react-native-toast-message": "^2.2.1",
    "react-native-uuid": "^2.0.3",
    "react-native-video": "^6.19.1",
    "react-native-voip-push-notification": "^3.3.2",
    "react-native-worklets": "^0.8.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "text-encoding": "^0.7.0",
    "timezones-list": "^3.1.0",
    "validator": "^13.15.23",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.7",
    "@babel/plugin-transform-react-jsx": "^7.25.9",
    "@babel/preset-env": "^7.26.7",
    "@babel/runtime": "^7.26.7",
    "@react-native-community/cli": "20.1.3",
    "@react-native-community/cli-platform-android": "20.1.3",
    "@react-native-community/cli-platform-ios": "20.1.3",
    "@react-native/babel-preset": "0.85.2",
    "@react-native/eslint-config": "0.85.2",
    "@react-native/jest-preset": "0.85.2",
    "@react-native/metro-config": "0.85.2",
    "@react-native/typescript-config": "0.85.2",
    "@sentry/cli": "^3.3.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.1",
    "@types/react-test-renderer": "^18.3.1",
    "@types/validator": "^13.15.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "icon-set-creator": "^1.2.6",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.3.4",
    "typescript": "~5.8.3",
    "@commitlint/config-conventional": "^17.0.2",
    "@evilmartians/lefthook": "^1.5.0",
    "@release-it/conventional-changelog": "^9.0.2",
    "commitlint": "^17.0.2",
    "del-cli": "^5.1.0",
    "react-native-builder-bob": "^0.35.2",
    "release-it": "^17.10.0",
    "turbo": "^1.10.7"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "rules": {
      "react/react-in-jsx-scope": "off",
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "esm": true
        }
      ]
    ]
  }
}
