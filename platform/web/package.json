{
  "name": "@openpeepshq/web",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @openpeepshq/greenscreen build",
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "build:watch": "concurrently --names tsc,vite -c blue,magenta \"tsc -b --noEmit --watch --preserveWatchOutput\" \"vite build --watch\"",
    "preview": "vite preview",
    "lint": "prettier --check . && ESLINT_USE_FLAT_CONFIG=false eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@openpeepshq/client": "workspace:^",
    "@openpeepshq/common": "workspace:^",
    "@openpeepshq/react": "workspace:^",
    "@openpeepshq/react-ui": "workspace:^",
    "@tanstack/react-query": "^5.0.0",
    "i18next": "^24.2.3",
    "lucide-react": "^0.469.0",
    "marked": "^15.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.10.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "workbox-window": "^7.3.0"
  }
}
