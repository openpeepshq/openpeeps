{
  "name": "@openpeepshq/common",
  "version": "0.4.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "date-fns": "^4.1.0",
    "ical-generator": "^10.2.0",
    "iso-639-1": "^3.1.5",
    "jose": "^6.2.2",
    "type-fest": "^5.5.0",
    "validator": "^13.15.35",
    "zod": "^4.4.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./zod": {
      "react-native": {
        "types": "./dist/zod.d.ts",
        "default": "./src/zod.ts"
      },
      "types": "./dist/zod.d.ts",
      "node": "./dist/zod.js",
      "default": "./dist/zod.js"
    },
    "./*": {
      "react-native": {
        "types": "./dist/*/index.d.ts",
        "default": "./src/*/index.ts"
      },
      "types": "./dist/*/index.d.ts",
      "node": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "!**/__tests__",
    "!**/*.test.ts"
  ],
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^24.1.12",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "concurrently": "^9.2.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^9.1.0",
    "i18next": "^26.0.3",
    "livekit-client": "^2.19.2",
    "prettier": "^3.8.1",
    "tsc-alias": "^1.8.16",
    "typed-emitter": "^2.1.0",
    "typescript": "^6.0.2",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "clean": "rm -rf tsconfig.tsbuildinfo dist",
    "typecheck": "tsc --noEmit",
    "build": "tsc && tsc-alias",
    "build:watch": "tsc && tsc-alias && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "prepublishOnly": "pnpm typecheck && pnpm build && node ../../scripts/check-publish-gate.mjs --package common",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  }
}
