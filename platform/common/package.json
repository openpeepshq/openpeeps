{
  "name": "@openpeeps/common",
  "version": "0.1.38",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "date-fns": "^4.1.0",
    "ical-generator": "^10.2.0",
    "iso-639-1": "^3.1.5",
    "jose": "^6.2.2",
    "type-fest": "^5.5.0",
    "validator": "^13.15.35",
    "zod": "^4.3.6"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*/index.js"
  },
  "files": [
    "/dist"
  ],
  "devDependencies": {
    "@types/node": "^24.1.12",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "concurrently": "^9.2.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "i18next": "^26.0.3",
    "livekit-client": "^2.18.1",
    "prettier": "^3.8.1",
    "tsc-alias": "^1.8.16",
    "typed-emitter": "^2.1.0",
    "typescript": "^6.0.2",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "clean": "rm -rf tsconfig.tsbuildinfo dist",
    "build": "tsc && tsc-alias",
    "build:watch": "tsc && tsc-alias && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "prepublishOnly": "pnpm build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  }
}