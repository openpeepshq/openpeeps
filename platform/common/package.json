{
  "name": "@openpeeps/common",
  "version": "0.1.37",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "date-fns": "^4.1.0",
    "iso-639-1": "^3.1.3",
    "type-fest": "^4.31.0",
    "validator": "^13.12.0",
    "zod": "^3.24.1"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*/index.js"
  },
  "files": [
    "/dist"
  ],
  "devDependencies": {
    "@types/node": "^22.10.3",
    "@types/validator": "^13.12.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "i18next": "^24.2.3",
    "livekit-client": "^2.1.2",
    "prettier": "^3.4.2",
    "tsc-alias": "^1.8.10",
    "typed-emitter": "^2.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "clean": "rm -f tsconfig.tsbuildinfo dist",
    "build": "tsc && tsc-alias",
    "build:watch": "tsc && tsc-alias && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "prepublishOnly": "pnpm build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  }
}