{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "declaration": true,
    "composite": true,
    "skipDefaultLibCheck": true,
    "rootDir": "src",
    "typeRoots": [
      "src/@types",
      "node_modules/@types"
    ],
    "types": [
      "node"
    ]
  },
  "exclude": [
    "vitest.config.ts",
    "**/*.test.ts",
    "**/*.spec.ts",
    "dist/**/*"
  ],
  "tsc-alias": {
    "verbose": false,
    "resolveFullPaths": true,
    "fileExtensions": {
      "inputGlob": "{js,mjs}",
      "outputCheck": [
        "js",
        "json",
        "mjs"
      ]
    }
  }
}