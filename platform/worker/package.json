{
  "name": "@openpeepshq/worker",
  "version": "0.1.3",
  "type": "module",
  "dependencies": {
    "@openpeepshq/common": "workspace:^",
    "@openpeepshq/core": "workspace:^",
    "command-line-args": "^5.2.1",
    "deepmerge-ts": "^5.1.0",
    "uuidv7": "^0.6.3"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*/index.js"
  },
  "files": [
    "/dist"
  ],
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "bullmq": "^5.34.7",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "lint": "prettier --check . && ESLINT_USE_FLAT_CONFIG=false eslint .",
    "format": "prettier --write .",
    "clean": "rm -rf tsconfig.tsbuildinfo dist",
    "build": "tsc && tsc-alias",
    "build:watch": "tsc && tsc-alias && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "prepublishOnly": "pnpm build",
    "uuidv7": "node -e 'import(\"uuidv7\").then(u => console.log(u.uuidv7()))'"
  }
}
