{
  "name": "@openpeeps/cli",
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "@openpeeps/core": "workspace:^",
    "commander": "^13.1.0",
    "deepmerge-ts": "^5.1.0",
    "dotenv": "^16.4.7",
    "uuidv7": "^0.6.3"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "opc": "./bin/opc.mjs"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*/index.js"
  },
  "files": [
    "/bin",
    "/dist"
  ],
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "lint": "prettier --check . && ESLINT_USE_FLAT_CONFIG=false eslint .",
    "format": "prettier --write .",
    "clean": "rm -rf tsconfig.tsbuildinfo dist",
    "build": "tsc && tsc-alias",
    "build:watch": "tsc && tsc-alias && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "prepublishOnly": "pnpm build"
  }
}
