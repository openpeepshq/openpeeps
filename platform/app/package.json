{
  "name": "@openpeeps/app",
  "version": "0.1.24",
  "main": "index.js",
  "license": "GPL-3.0-or-later",
  "private": "true",
  "type": "module",
  "workspaces": [
    "plugins/**/*",
    "core"
  ],
  "scripts": {
    "repl": "node repl.js",
    "dev": "DEBUG_COLORS=false DEBUG_HIDE_DATE=true DEBUG_DEPTH=20 vite dev",
    "worker": "node --watch worker.js",
    "checked-build": "./build.sh",
    "build": "npm run check && vite build",
    "build:deps": "pnpm install && pnpm --filter @openpeeps/app... build",
    "preview": "vite preview",
    "test": "npm run test:integration && npm run test:unit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "db:clear": "./apc db clear",
    "db:clear:test": "DB_NAME=test ./apc db clear",
    "db:migrate": "node runMigrations.js",
    "test:integration": "if [ -z \"$CI\" ]; then npm run db:clear:test; fi && unset FORCE_COLOR && DB_NAME=test playwright test",
    "test:integration:no-clean": "unset FORCE_COLOR && DB_NAME=test playwright test",
    "test:unit": "vitest run",
    "redis:memory": "node redis-memory-tree.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.13",
    "@openpeeps/cli": "workspace:^",
    "@openpeeps/core": "workspace:^",
    "@openpeeps/worker": "workspace:^",
    "@sentry/sveltekit": "^9",
    "bcrypt": "^5.1.1",
    "date-fns": "^4.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "jsdom": "^24.0.0",
    "jsonpath": "^1.1.1",
    "mdsvex": "^0.12.3",
    "sharp": "^0.33.5",
    "ua-parser-js": "^2.0.9"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "@openpeeps/common": "workspace:^",
    "@openpeeps/svelte": "workspace:^",
    "@openpeeps/ui": "workspace:^",
    "@playwright/test": "^1.56.1",
    "@skeletonlabs/skeleton": "^2.10.3",
    "@skeletonlabs/tw-plugin": "^0.4.0",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.15.2",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@tanstack/svelte-query": "^5.62.7",
    "@types/debug": "^4.1.12",
    "@types/jsdom": "^21.1.7",
    "@types/jsonpath": "^0.2.4",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^24.1.0",
    "@types/validator": "^13.11.9",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "change-case": "^5.4.3",
    "debug": "^4.4.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-svelte": "^2.46.1",
    "layerchart": "^0.60.3",
    "lucide-svelte": "^0.561.0",
    "mime-types": "^2.1.35",
    "prettier": "^3.2.5",
    "prettier-plugin-svelte": "^3.2.6",
    "redis": "^5.10.0",
    "remark-sectionize": "^2.0.0",
    "svelte": "^5.20.0",
    "svelte-check": "^4.0.0",
    "svelte-easy-crop": "^3.0.1",
    "svelte-eslint-parser": "^0.43.0",
    "sveltekit-api": "^0.6.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.0",
    "uuidv7": "^0.6.3",
    "validator": "^13.11.0",
    "vite": "^5.4.11",
    "vite-plugin-tailwind-purgecss": "^0.2.0",
    "vitest": "^1.3.1",
    "workbox-precaching": "^7.0.0",
    "zod": "^4.3.6"
  }
}