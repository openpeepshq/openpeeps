#!/bin/sh
# Backwards-compatible wrapper around the `@openpeeps/cli` bin. Prefer the
# `opc` binary on PATH (the Dockerfile symlinks it into /usr/local/bin), and
# fall back to invoking the bundled script directly so this works in any
# environment where the workspace layout is preserved (Docker image, source
# checkout, deployment scripts that exec it via absolute path).

if command -v opc >/dev/null 2>&1; then
  exec opc "$@"
fi

HERE="$(cd "$(dirname "$0")" && pwd)"
exec node "$HERE/../cli/bin/opc.mjs" "$@"
