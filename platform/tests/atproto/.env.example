# Local OpenPeeps API (pnpm dev). /xrpc is mounted only when
# atproto.active is true and the API has been restarted.
ATPROTO_ORIGIN=http://localhost:5173
ATPROTO_HANDLE_DOMAIN=localhost

# Account used to create notes. REGISTER=1 creates it on first run.
EMAIL=atproto@openpeeps.test
PASSWORD=atproto-test-12
HANDLE=atproto
REGISTER=1

