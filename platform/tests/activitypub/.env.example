# ── Federation test harness configuration ──────────────────────────
# setup.sh generates/overwrites secrets on first run. Hand-edit the domain/mode
# keys below for your deployment; the rest are generated for you.
# Compose reads this file automatically (no need to pass -f for it).

# Domain suffix for alpha.<suffix>, beta.<suffix>, mastodon.<suffix>
DNS_SUFFIX=activity-pub.test.ap.social

# 0 = local/laptop (self-signed cert), 1 = public VM (Let's Encrypt via certbot)
PUBLIC=0

# Let's Encrypt account email (only used when PUBLIC=1; omit for anonymous LE)
ACME_EMAIL=

# OpenPeeps JWT secret (setup.sh randomizes this when PUBLIC=1)
JWT_SECRET=test-jwt-secret-change-me

# ── Mastodon secrets (generated by setup.sh if left empty) ─────────
# Run:  openssl rand -hex 64  (for SECRET_KEY_BASE)
# Run:  openssl rand -hex 40  (for OTP_SECRET)
MASTODON_SECRET_KEY_BASE=
MASTODON_OTP_SECRET=

# ── Email / SMTP ───────────────────────────────────────────────────
# Leave empty for the local Mailpit default (no real email is sent).
# On a public VM, point these at a real SMTP host so Mastodon and
# OpenPeeps can send real notifications.
SMTP_SERVER=
SMTP_PORT=1025
SMTP_DOMAIN=
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_AUTHENTICATION=none
SMTP_LOGIN=
SMTP_PASSWORD=

# OpenPeeps email transport (defaults shown are Mailpit)
EMAIL_CONFIG_HOST=
EMAIL_CONFIG_PORT=1025
EMAIL_CONFIG_SECURE=false
EMAIL_CONFIG_AUTH_USER=
EMAIL_CONFIG_AUTH_PASS=
EMAIL_DEFAULT_FROM=
