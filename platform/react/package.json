{
  "name": "@openpeepshq/react",
  "version": "0.2.5",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./dist/react-native.js",
      "default": "./dist/index.js"
    },
    "./pwa": "./dist/pwa/index.js",
    "./pwa-vite": "./dist/pwa/vite.js",
    "./pages": "./dist/pages/index.js",
    "./service-worker": "./src/pwa/sw.ts",
    "./*": "./dist/*/index.js"
  },
  "files": [
    "/dist",
    "/src/pwa/sw.ts",
    "/src/pwa/sw-types.ts",
    "/src/pwa/navigationUrl.ts"
  ],
  "scripts": {
    "lint": "prettier --check . && ESLINT_USE_FLAT_CONFIG=false eslint .",
    "format": "prettier --write .",
    "clean": "rm -rf tsconfig.tsbuildinfo dist",
    "build": "tsc && tsc-alias",
    "build:watch": "tsc && tsc-alias && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.2",
    "@livekit/components-react": "^2.9.21",
    "@livekit/components-styles": "^1.1.6",
    "@openpeepshq/client": "workspace:^",
    "@openpeepshq/common": "workspace:^",
    "@openpeepshq/greenscreen": "workspace:^",
    "@openpeepshq/react-ui": "workspace:^",
    "@tanstack/react-query": "5.90.16",
    "@videojs/react": "^10.0.0-beta.24",
    "emoji-picker-element": "^1.29.1",
    "heic2any": "^0.0.4",
    "i18next": "^24.2.3",
    "i18next-http-backend": "^3.0.2",
    "js-base64": "^3.7.7",
    "livekit-client": "2.19.2",
    "lucide-react": "^0.469.0",
    "marked": "^15.0.6",
    "qrcode": "^1.5.4",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "^7.73.1",
    "react-i18next": "^15.4.1",
    "uuidv7": "^1.0.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@openpeepshq/fetch-client": "workspace:^",
    "@types/node": "^22.13.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "^9.1.2",
    "eslint": "^9.19.0",
    "react-router-dom": "^7.0.0",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
