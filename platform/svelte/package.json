{
	"name": "@openpeeps/svelte",
	"version": "0.1.35",
	"license": "MIT",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm run package",
		"build:watch": "vite build --watch && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "pnpm build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./*": {
			"types": "./dist/*/index.d.ts",
			"svelte": "./dist/*/index.js",
			"default": "./dist/*/index.js"
		}
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.15.1",
		"svelte": "^5.20.0"
	},
	"devDependencies": {
		"@openpeeps/client": "workspace:^",
		"@openpeeps/fetch-client": "workspace:^",
		"@openpeeps/svelte5-email": "workspace:^",
		"@openpeeps/ui": "workspace:^",
		"@eslint/compat": "^1.2.3",
		"@humanspeak/svelte-markdown": "^0.7.18",
		"@playwright/test": "^1.45.3",
		"@sentry/sveltekit": "^9",
		"@skeletonlabs/skeleton": "^2.10.3",
		"@skeletonlabs/tw-plugin": "^0.4.0",
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/kit": "^2.15.2",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@tanstack/svelte-query": "^5.62.7",
		"@types/d3-scale": "^4.0.9",
		"@types/node": "^22.10.5",
		"@types/validator": "^13.12.2",
		"autoprefixer": "^10.4.20",
		"caniuse-lite": "^1.0.30001743",
		"date-fns": "^4.1.0",
		"deep-object-diff": "^1.1.9",
		"eslint": "^9.7.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.36.0",
		"fast-deep-equal": "^3.1.3",
		"globals": "^15.0.0",
		"iso8601-duration": "^2.1.2",
		"js-base64": "^3.7.7",
		"layerchart": "^0.60.3",
		"livekit-client": "^2.1.2",
		"lucide-svelte": "^0.561.0",
		"marked": "^15.0.6",
		"prettier": "^3.3.2",
		"prettier-plugin-svelte": "^3.2.6",
		"prettier-plugin-tailwindcss": "^0.6.5",
		"publint": "^0.2.0",
		"sse.js": "^2.5.0",
		"svelte": "^5.20.0",
		"svelte-check": "^4.0.0",
		"svelte-easy-crop": "^3.0.1",
		"svelte-persisted-state": "^1.0.0",
		"svelte-persisted-store": "^0.12.0",
		"tailwindcss": "^3.4.9",
		"tsc-alias": "^1.8.10",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0",
		"uuidv7": "^1.0.2",
		"validator": "^13.11.0",
		"vite": "^5.4.11",
		"vitest": "^2.0.4",
		"zod": "^3.23.8"
	},
	"dependencies": {
		"@openpeeps/common": "workspace:^",
		"@openpeeps/greenscreen": "workspace:^",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.15",
		"d3-scale": "^4.0.2",
		"heic2any": "^0.0.4",
		"i18next": "^24.2.3"
	}
}