{
  "name": "@openpeeps/server",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "dist/server/server.js",
  "scripts": {
    "dev": "NODE_ENV=development DEBUG=riddl,server,server:request vite-node --watch src/server.ts",
    "build": "vite build --ssr src/server.ts --outDir dist",
    "start": "NODE_ENV=production vite-node dist/server.js",
    "start:node": "NODE_ENV=production node dist/server.js",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openpeeps/cli": "workspace:^",
    "@openpeeps/common": "workspace:^",
    "@openpeeps/core": "workspace:^",
    "@openpeeps/worker": "workspace:^",
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@riddl/core": "^0.2.0",
    "jsdom": "^24.0.0",
    "jsonpath": "^1.1.1",
    "sharp": "^0.33.5",
    "express": "^5.2.1",
    "js-base64": "^3.7.7",
    "uuidv7": "^1.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.10",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vite-node": "^5.3.0"
  }
}
