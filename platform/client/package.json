{
  "name": "@openpeeps/client",
  "version": "0.1.32",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@openpeeps/common": "workspace:^",
    "@openpeeps/fetch-client": "workspace:^",
    "validator": "^13.11.0",
    "zod": "^4.4.3"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*/index.js"
  },
  "files": [
    "/dist"
  ],
  "devDependencies": {
    "@types/validator": "^13.11.9",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "i18next": "^24.2.3",
    "livekit-client": "^2.1.2",
    "prettier": "^3.4.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "clean": "rm -rf tsconfig.tsbuildinfo dist",
    "build": "tsc && tsc-alias",
    "build:watch": "tsc && tsc-alias && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "prepublishOnly": "pnpm build"
  }
}
