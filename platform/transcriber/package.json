{
  "name": "@openpeepshq/transcriber",
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@openpeepshq/common": "workspace:*",
    "@openpeepshq/core": "workspace:*"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": ["/dist"],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "clean": "rm -rf tsconfig.tsbuildinfo dist",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.19.17",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^6.0.2"
  }
}
