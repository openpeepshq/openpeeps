{
  "compilerOptions": {
    "target": "es2019",
    "module": "esnext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "declaration": true,
    "skipDefaultLibCheck": true,
    "rootDir": "src"
  },
  "include": ["src/**/*"]
}
