{
  "name": "@openpeepshq/arango-migrate",
  "version": "0.1.0",
  "private": true,
  "description": "ARCHIVE: Arango → Postgres export/import/validate CLI. Not part of the OpenPeeps runtime.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "bin": {
