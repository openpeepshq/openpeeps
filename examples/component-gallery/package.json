{
  "name": "@openpeepshq/component-gallery",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @openpeepshq/common build && pnpm --filter @openpeepshq/client build && pnpm --filter @openpeepshq/i18n build",
    "dev": "vite",
    "build": "node scripts/build-all-versions.mjs",
    "build:local": "GALLERY_LOCAL=1 node scripts/build-all-versions.mjs",
    "build:app": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.2",
    "@openpeepshq/common": "workspace:^",
    "@openpeepshq/i18n": "workspace:^",
    "@openpeepshq/react": "workspace:^",
    "@openpeepshq/react-ui": "workspace:^",
    "i18next": "^24.2.3",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.73.1",
    "react-router-dom": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
