{
  "name": "@openpeepshq-examples/greeter-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Example OpenPeeps plugin demonstrating backend events, API routes, config, and a frontend component. Only loaded when referenced in the root package.json's `openpeeps.plugins` array.",
  "repository": {
    "type": "git",
    "url": "https://code.openpeeps.org/openpeeps/openpeeps",
    "directory": "examples/greeter-plugin"
  },
  "openpeeps": {
    "enabled": false
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "format": "prettier --write --ignore-path ../../.prettierignore ."
  },
  "dependencies": {
    "@openpeepshq/common": "workspace:^",
    "@openpeepshq/core": "workspace:^",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.10",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2",
    "@eslint/js": "^9.17.0"
  }
}
